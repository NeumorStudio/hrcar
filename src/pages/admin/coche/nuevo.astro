---
import Admin from '../../../layouts/Admin.astro';
import FormularioCoche from '../../../components/FormularioCoche.astro';
import { obtenerCoche, marcasYModelos } from '../../../lib/datos.js';
const db = Astro.locals.runtime.env.DB;
// «Duplicar»: el alta sale con los datos de otro coche (sin fotos, matrícula, kilómetros ni datos internos)
const desde = Astro.url.searchParams.get('desde');
const [{ marcas, modelos }, base] = await Promise.all([marcasYModelos(db), desde ? obtenerCoche(db, desde) : null]);
---
<Admin titulo="Añadir vehículo" seccion="inventario">
  <div class="fila-titulo"><div><h1>Añadir vehículo</h1><p class="suave">{base ? <>Copiado de <b>{base.titulo}</b>: revisa los datos, pon los kilómetros y las fotos, y publica.</> : 'Rellena los pasos y pulsa «Publicar vehículo». Aparecerá en la web al momento.'}</p></div><a class="boton secundario" href="/admin/inventario">Cancelar</a></div>
  <FormularioCoche coche={null} marcas={marcas} modelos={modelos} base={base} />
</Admin>
