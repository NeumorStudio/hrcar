---
// Página que abre el vendedor desde su enlace: lee el acuerdo, pone su DNI (y lo que falte) y firma con el dedo.
// Ya firmado, el mismo enlace le deja descargar su copia en PDF.
import { contratoPorToken } from '../../lib/captaciones.js';
import { camposVendedor } from '../../lib/firma.js';
import { rellenar, bloques, TOKEN_VALIDO, fechaHora } from '../../lib/contrato.js';
import { MARCA } from '../../lib/marca.js';
export const prerender = false;
const env = Astro.locals.runtime.env;
const token = Astro.params.token || '';
const k = TOKEN_VALIDO.test(token) ? await contratoPorToken(env.DB, token) : null;
for (const [h, v] of Object.entries({
  'Cache-Control': 'no-store',
  'Vercel-CDN-Cache-Control': 'no-store',
  'X-Robots-Tag': 'noindex, nofollow',
  'Content-Security-Policy': "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'",
})) Astro.response.headers.set(h, v);
if (!k) Astro.response.status = 404;
// «abierto por el vendedor» lo apunta public/js/firmar.js al cargar la página (las vistas previas de WhatsApp y del
// correo descargan el enlace sin ejecutar nada, y no deben contar)
const campos = k && ['Pendiente', 'Visto'].includes(k.estado) ? camposVendedor(k) : [];
const SEP = '\u0000';
const conHuecos = k ? { ...k.datos } : {};
for (const [campo] of campos) conHuecos[campo] = `${SEP}${campo}${SEP}`;
const texto = k ? (k.estado === 'Firmado' ? k.texto_firmado : rellenar(k.plantilla, conHuecos)) : '';
const partes = (t) => t.split(SEP);
const empresa = k?.datos?.empresa_nombre || MARCA.nombre;
const nombre = (k?.datos?.vendedor_nombre || '').split(' ')[0];
// eslint-disable-next-line no-undef
const VERSION = typeof __BUILD__ !== 'undefined' ? __BUILD__ : 'dev';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#111111" />
    <title>{k ? `Acuerdo para firmar · ${empresa}` : 'Enlace no válido'}</title>
    <link rel="icon" href={MARCA.logo} />
    <style>
      :root { --texto: #111827; --suave: #6b7280; --borde: #e5e7eb; --fondo: #f3f4f6; --verde: #047857; --rojo: #b91c1c; --amarillo: #fef3c7; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--fondo); color: var(--texto); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      header { background: #111; color: #fff; padding: 14px 16px; display: flex; align-items: center; gap: 10px; }
      header img { width: 34px; height: 34px; border-radius: 8px; }
      header b { letter-spacing: 0.02em; }
      main { max-width: 760px; margin: 0 auto; padding: 16px 16px 120px; }
      .caja { background: #fff; border: 1px solid var(--borde); border-radius: 14px; padding: 20px; margin-bottom: 16px; }
      h1 { font-size: 1.35rem; margin: 0 0 6px; }
      .suave { color: var(--suave); font-size: 0.92rem; }
      .contrato h2 { font-size: 1.15rem; text-align: center; margin: 4px 0 14px; }
      .contrato h3 { font-size: 0.98rem; margin: 18px 0 8px; }
      .contrato p { margin: 0 0 10px; }
      .contrato ul { margin: 0 0 12px; padding-left: 22px; }
      .contrato li { margin-bottom: 4px; }
      .hueco { background: var(--amarillo); border-radius: 4px; padding: 0 4px; font-weight: 600; }
      .hueco.lleno { background: #d1fae5; }
      label { display: block; margin-bottom: 14px; }
      label > span { display: block; font-weight: 600; font-size: 0.92rem; margin-bottom: 6px; }
      input[type=text] { width: 100%; padding: 13px 14px; font: inherit; border: 1px solid #d1d5db; border-radius: 10px; background: #fff; }
      input.error, .lienzo.error { border-color: var(--rojo); background: #fff7f7; }
      .acepto { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; }
      .acepto input { width: 22px; height: 22px; margin-top: 2px; flex: none; }
      .lienzo { position: relative; border: 2px dashed #9ca3af; border-radius: 12px; background: #fff; touch-action: none; height: 200px; }
      .lienzo canvas { width: 100%; height: 100%; display: block; border-radius: 10px; cursor: crosshair; }
      .lienzo .pista { position: absolute; inset: 0; display: grid; place-items: center; color: #9ca3af; pointer-events: none; font-size: 0.95rem; }
      .fila { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 8px 0 0; }
      button { font: inherit; cursor: pointer; }
      .boton { display: block; width: 100%; padding: 16px; border-radius: 12px; border: 0; background: #111; color: #fff; font-weight: 700; font-size: 1.05rem; }
      .boton[disabled] { opacity: 0.6; }
      .enlace { background: none; border: 0; color: #2563eb; text-decoration: underline; padding: 4px; }
      .error-texto { color: var(--rojo); font-weight: 600; margin: 10px 0 0; }
      .ok { border-color: #a7f3d0; background: #ecfdf5; }
      .ok h1 { color: var(--verde); }
    </style>
  </head>
  <body>
    <header><img src={MARCA.logo} alt="" width="34" height="34" /><b>{empresa}</b></header>
    <main>
      {!k && (
        <div class="caja"><h1>Este enlace no existe</h1><p class="suave">Puede que esté mal copiado. Pide a quien te lo mandó que te envíe uno nuevo.</p></div>
      )}
      {k && ['Anulado', 'Caducado'].includes(k.estado) && (
        <div class="caja"><h1>{k.estado === 'Caducado' ? 'Este enlace ha caducado' : 'Este enlace ya no es válido'}</h1><p class="suave">Pide a {empresa} que te mande uno nuevo.</p></div>
      )}
      {k && k.estado === 'Firmado' && (
        <div class="caja ok" data-firmado data-token={token}>
          <h1>Acuerdo firmado</h1>
          <p>Lo firmaste el {fechaHora(k.firmado)}. Guarda tu copia:</p>
          <button type="button" class="boton" data-descargar>Descargar mi copia en PDF</button>
          <p class="error-texto" data-error hidden></p>
        </div>
      )}
      {k && ['Pendiente', 'Visto'].includes(k.estado) && (
        <div class="caja">
          <h1>Hola{nombre ? `, ${nombre}` : ''}</h1>
          <p class="suave">Lee el acuerdo con calma. Abajo pones tus datos y firmas con el dedo (o con el ratón). Lo marcado en amarillo se rellena con lo que escribas.</p>
        </div>
      )}
      {k && k.estado !== 'Anulado' && k.estado !== 'Caducado' && (
        <article class="caja contrato">
          {bloques(texto).map((b) => {
            const contenido = b.tipo === 'lista' ? null : partes(b.texto).map((p, i) => (i % 2 === 1 ? <span class="hueco" data-hueco={p}>{k.datos?.[p] || '…'}</span> : p));
            if (b.tipo === 'lista') return <ul>{b.items.map((it) => <li>{partes(it).map((p, i) => (i % 2 === 1 ? <span class="hueco" data-hueco={p}>{k.datos?.[p] || '…'}</span> : p))}</li>)}</ul>;
            return b.tipo === 'titulo' ? <h2>{contenido}</h2> : b.tipo === 'apartado' ? <h3>{contenido}</h3> : <p>{contenido}</p>;
          })}
        </article>
      )}
      {campos.length > 0 && (
        <form class="caja" data-firmar data-token={token} data-visto={k.estado === 'Pendiente' ? '' : '1'} novalidate>
          <h2 style="margin-top:0;font-size:1.1rem">Tus datos y tu firma</h2>
          {campos.map(([campo, etiqueta, obligatorio, valor]) => (
            <label><span>{etiqueta}</span><input type="text" name={campo} value={valor} required={obligatorio} autocomplete={campo === 'vendedor_nombre' ? 'name' : campo === 'vendedor_domicilio' ? 'street-address' : 'off'} autocapitalize={['vendedor_dni', 'matricula', 'bastidor'].includes(campo) ? 'characters' : 'words'} /></label>
          ))}
          <label><span>Tu firma</span></label>
          <div class="lienzo" data-lienzo><canvas></canvas><span class="pista" data-pista>Firma aquí con el dedo</span></div>
          <div class="fila"><span class="suave">Firma como en tu DNI.</span><button type="button" class="enlace" data-borrar-firma>Borrar y repetir</button></div>
          <label class="acepto" style="margin-top:16px"><input type="checkbox" name="acepto" /> <span style="font-weight:400">He leído el acuerdo y lo acepto. Firmo con mis datos de forma electrónica.</span></label>
          <button type="submit" class="boton">Firmar el acuerdo</button>
          <p class="error-texto" data-error hidden></p>
          <p class="suave" style="margin-top:12px">Al firmar se guardan la fecha y hora, la dirección IP y el tipo de dispositivo, para dejar constancia de la firma.</p>
        </form>
      )}
    </main>
    <script src={`/js/firmar.js?v=${VERSION}`} defer></script>
  </body>
</html>
