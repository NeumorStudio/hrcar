---
import { NEGOCIO } from '../negocio.js';
// Esqueleto del panel de administración (/admin).
// En el ordenador, menú arriba; en el móvil, barra abajo con lo de cada día (como una app) y «Más» para el resto.
import { contarMensajesNuevos } from '../lib/datos.js';
interface Props { titulo: string; seccion?: string; sinMenu?: boolean; sinReferer?: boolean }
const { titulo, seccion = '', sinMenu = false, sinReferer = false } = Astro.props;
const quien = Astro.locals.usuario?.nombre || '';
let nuevos = 0;
if (!sinMenu) {
  try { nuevos = await contarMensajesNuevos(Astro.locals.runtime.env.DB); } catch { nuevos = 0; }
}
const enlaces = [
  ['inicio', '/admin', 'Inicio'],
  ['inventario', '/admin/inventario', 'Inventario'],
  ['clientes', '/admin/clientes', 'Clientes'],
  ['tareas', '/admin/tareas', 'Tareas'],
  ['ventas', '/admin/ventas', 'Ventas'],
  ['calculadora', '/admin/calculadora', 'Calculadora'],
  ['mensajes', '/admin/mensajes', 'Mensajes'],
  ['web', '/admin/web', 'Tu web'],
  ['ajustes', '/admin/ajustes', 'Ajustes'],
];
const ICONOS: Record<string, string> = {
  inicio: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/>',
  inventario: '<path d="M5 16.5h14M6 16.5l1.6-5.2a2 2 0 0 1 1.9-1.4h5a2 2 0 0 1 1.9 1.4l1.6 5.2"/><path d="M4 16.5v2.5h2.5v-2.5M17.5 16.5v2.5H20v-2.5"/><circle cx="8" cy="14" r=".6"/><circle cx="16" cy="14" r=".6"/>',
  mensajes: '<path d="M4 5.5h16v10.5H9l-5 4z"/>',
  clientes: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><path d="M15.5 5.6a3 3 0 0 1 0 5.8M17.5 14.3c1.6.6 2.6 2.2 3 4.7"/>',
  mas: '<circle cx="5.5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="18.5" cy="12" r="1.3"/>',
};
const icono = (id: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONOS[id]}</svg>`;
const abajo = [['inicio', '/admin', 'Inicio'], ['inventario', '/admin/inventario', 'Coches'], ['mensajes', '/admin/mensajes', 'Mensajes'], ['clientes', '/admin/clientes', 'Clientes']];
const enMas = ['tareas', 'ventas', 'calculadora', 'web', 'ajustes'].includes(seccion);
// cambia con cada publicación: el móvil del dueño no se queda con un admin.js viejo
// eslint-disable-next-line no-undef
const VERSION = typeof __BUILD__ !== 'undefined' ? __BUILD__ : 'dev';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    {sinReferer && <meta name="referrer" content="no-referrer" />}
    <meta name="theme-color" content="#0c0c0c" />
    <title>{titulo} · Panel {NEGOCIO.nombre}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/admin/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/admin/icono-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content={NEGOCIO.nombre} />
    <link rel="stylesheet" href={`/admin/admin.css?v=${VERSION}`} />
    <script src={`/admin/admin.js?v=${VERSION}`} defer></script>
  </head>
  <body class={sinMenu ? 'sin-menu' : 'con-barra'}>
    {!sinMenu && (
      <header class="cabecera">
        <a class="marca" href="/admin"><img src={NEGOCIO.logo} alt="" width="36" height="36" style="border-radius:50%" /><span>{NEGOCIO.nombre} <small>panel</small></span></a>
        <nav class="menu" aria-label="Secciones">
          {enlaces.map(([id, href, texto]) => (
            <a href={href} class={id === seccion ? 'activo' : ''} aria-current={id === seccion ? 'page' : undefined}>
              {texto}{id === 'mensajes' && nuevos > 0 && <span class="globo" aria-label={`${nuevos} sin leer`}>{nuevos}</span>}
            </a>
          ))}
          <a href="/" target="_blank" rel="noopener" class="externo">Ver web ↗</a>
          <form method="post" action="/api/admin/salir" class="salir"><button type="submit" class="enlace" title={quien ? `Sesión de ${quien}` : ''}>Salir{quien === 'Soporte' && <small class="quien"> (soporte)</small>}</button></form>
        </nav>
        <a href="/" target="_blank" rel="noopener" class="ver-web-movil">Ver web ↗</a>
      </header>
    )}
    <main class="contenido">
      <slot />
    </main>
    {!sinMenu && (
      <>
        <nav class="barra-inferior" aria-label="Secciones">
          {abajo.map(([id, href, texto]) => (
            <a href={href} class={id === seccion ? 'activo' : ''} aria-current={id === seccion ? 'page' : undefined}>
              <Fragment set:html={icono(id)} />
              <span>{texto}</span>
              {id === 'mensajes' && nuevos > 0 && <span class="globo" aria-label={`${nuevos} sin leer`}>{nuevos}</span>}
            </a>
          ))}
          <button type="button" class={enMas ? 'activo' : ''} data-mas aria-expanded="false" aria-controls="hoja-mas"><Fragment set:html={icono('mas')} /><span>Más</span></button>
        </nav>
        <div class="hoja-mas" id="hoja-mas" data-hoja-mas hidden>
          <div class="hoja-fondo" data-cerrar-mas></div>
          <div class="hoja" role="dialog" aria-label="Más secciones">
            <a href="/admin/tareas" class={seccion === 'tareas' ? 'activo' : ''}>Tareas</a>
            <a href="/admin/ventas" class={seccion === 'ventas' ? 'activo' : ''}>Ventas</a>
            <a href="/admin/calculadora" class={seccion === 'calculadora' ? 'activo' : ''}>Calculadora de importación</a>
            <a href="/admin/web" class={seccion === 'web' ? 'activo' : ''}>Tu web: qué se ve</a>
            <a href="/admin/ajustes" class={seccion === 'ajustes' ? 'activo' : ''}>Ajustes y copia de seguridad</a>
            <a href="/" target="_blank" rel="noopener">Ver la web ↗</a>
            <form method="post" action="/api/admin/salir"><button type="submit">Salir{quien === 'Soporte' && ' (soporte)'}</button></form>
          </div>
        </div>
      </>
    )}
    <div class="avisos" data-avisos aria-live="polite"></div>
  </body>
</html>
