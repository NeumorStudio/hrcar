---
// Páginas que en la web actual existen pero apenas tienen contenido (alquiler, blog, vendidos, 404).
import Marco from '../Marco.astro';
interface Props { pagina: string; title: string; description?: string; titulo: string; texto: string; robots?: string; enlaces?: [string, string][] }
const { pagina, title, description, titulo, texto, robots = 'index, follow', enlaces = [['/stock', 'Ver el stock'], ['/custom-order', 'Encargar a medida']] } = Astro.props;
---
<Marco pagina={pagina} title={title} description={description} robots={robots}>
  <div class="envoltorio pagina-sencilla" style="min-height:50vh">
    <h1>{titulo}</h1>
    <p class="intro">{texto}</p>
    <div class="hero-acciones" style="margin-top:22px">
      {enlaces.map(([href, t], i) => <a class:list={['btn', 'grande', { contorno: i > 0 }]} href={href}>{t}</a>)}
    </div>
  </div>
</Marco>
