/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Archivos con huella en el nombre: no cambian nunca (el navegador y el CDN de Vercel los guardan un año)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos de serie de la web: cambian muy rara vez
/img/*
  Cache-Control: public, max-age=86400

# Fuente Inter alojada aquí (el nombre lleva la versión: no cambia nunca)
/fuentes/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
